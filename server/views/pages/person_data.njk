{% extends "../partials/layout.njk" %}

{% from "govuk/components/input/macro.njk" import govukInput %}
{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/button/macro.njk" import govukButton %}

{% set pageTitle = applicationName + " - EM notifications for people on probation" %}
{% set mainClasses = "app-container govuk-body" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <h1 class="govuk-heading-l">Person on probation information</h1>

      <p class="govuk-body govuk-hint">
        This demo will enable you to trigger a violation notification via SMS to the phone number provided.
        Your information will not be used for anything else.
      </p>

      {% if errors and errors.length %}
        {{ govukErrorSummary({
          titleText: "There is a problem",
          errorList: errors
        }) }}
      {% endif %}

      <form action="/person-data" method="post" novalidate>

        {{ govukInput({
          label: {
            text: "First name"
          },
          id: "first-name",
          name: "givenName",
          classes: "govuk-input--width-20",
          errorMessage: errorsByField.givenName,
          value: data.givenName
        }) }}

        {{ govukInput({
          label: {
            text: "Last name"
          },
          id: "family-name",
          name: "familyName",
          classes: "govuk-input--width-20",
          errorMessage: errorsByField.familyName,
          value: data.familyName
        }) }}

        {{ govukInput({
          label: {
            text: "Mobile number"
          },
          id: "phoneNumber",
          name: "phoneNumber",
          type: "tel",
          autocomplete: "tel",
          classes: "govuk-input--width-20",
          errorMessage: errorsByField.phoneNumber,
          value: data.phoneNumber
        }) }}

        {{ govukButton({
          text: "Continue"
        }) }}

      </form>

    </div>
  </div>
{% endblock %}
