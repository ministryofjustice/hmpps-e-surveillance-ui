{% extends "../partials/layout.njk" %}
{% from "govuk/components/table/macro.njk" import govukTable %}

{% set pageTitle = applicationName + " - " + "Notifications generated" %}
{% set mainClasses = "app-container govuk-body" %}

{% block content %}
  <h1>Notifications generated</h1>
    {% if rows and rows | length > 0 %}
        {{ govukTable({
      caption: caption,
      captionClasses: "govuk-table__caption--m",
      firstCellIsHeader: true,
      head: headers,
      rows: rows
    }) }}
    {% else %}
      <p class="govuk-body">No notification generated yet. Please <a class="govuk-link" href="/upload-file">upload</a> the events file.</p>
    {% endif %}
{% endblock %}
