<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Saving your data...</title>
</head>
<body>
  <p>Saving your data, please wait...</p>
  {{ cspNonce }}
  <script nonce="{{ cspNonce }}">
    (function() {
      const data = {{ data | safe }};
      localStorage.setItem("{{ key }}", JSON.stringify(data));
      window.location.href = "{{ redirectUrl }}";
    })();
  </script>
</body>
</html>
